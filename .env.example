# PostgreSQL Database URLs (Neon Serverless PostgreSQL recommended for Vercel)
# DATABASE_URL uses the connection pooler URL for Vercel Serverless Functions
DATABASE_URL="postgresql://user:password@ep-cool-pooler.us-east-2.aws.neon.tech/expensetracker?sslmode=require"
# DIRECT_URL uses the direct connection URL for Prisma CLI migrations
DIRECT_URL="postgresql://user:password@ep-cool.us-east-2.aws.neon.tech/expensetracker?sslmode=require"

# NestJS Server Configuration
PORT=4000
NODE_ENV=development
JWT_SECRET="super-secret-jwt-key-change-in-production-min-32-chars"
JWT_EXPIRES_IN="7d"

# Frontend Configuration
VITE_API_BASE_URL="http://localhost:4000/api"
